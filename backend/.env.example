# Defaults to a local SQLite file (fraud_platform.db) if unset - zero setup
# needed for development or demoing the project.
#
# To use PostgreSQL instead (recommended before any real deployment):
# DATABASE_URL=postgresql://username:password@localhost:5432/fraud_platform

# Browser origins allowed to call the API directly (CORS), comma-separated.
# Defaults to the local Vite dev/preview servers (localhost/127.0.0.1 on
# ports 5173 and 4173) if unset. Not needed for local development: the
# dashboard uses Vite's /api proxy. Set it when the frontend is served from
# another origin and calls the API directly (VITE_API_BASE_URL). "*" allows
# any origin (credentials are then disabled).
# CORS_ALLOW_ORIGINS=https://your-frontend-domain.com
#
# Use this file by copying it to .env and starting the server with:
#   uvicorn app.main:app --port 8000 --env-file .env
