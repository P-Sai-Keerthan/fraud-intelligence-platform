# NOTE: the backend reads REAL ENVIRONMENT VARIABLES; it does not load a .env file by itself.
# Export these in your shell / process manager (copying this file to .env alone has no effect).
#
# Browser origins allowed to call the API cross-origin (comma-separated). Default: the Vite
# dev server. Set this to your deployed frontend origin; credentials are never enabled.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
# In-process, per-client-IP request budgets (requests per minute) for the expensive endpoints,
# and RATE_LIMIT_ENABLED=0 to switch the limiter off. Demo-level only; see README.
# RATE_LIMIT_PREDICT_PER_MIN=120
# RATE_LIMIT_BATCH_PER_MIN=6
# RATE_LIMIT_REPORT_PER_MIN=60
# RATE_LIMIT_METRICS_PER_MIN=30
# RATE_LIMIT_METRICS_REFRESH_PER_MIN=6
# RATE_LIMIT_RINGS_PER_MIN=60
#
# Defaults to a local SQLite file (fraud_platform.db) if unset - zero setup
# needed for development or demoing the project.
#
# To use PostgreSQL instead (recommended before any real deployment):
# DATABASE_URL=postgresql://username:password@localhost:5432/fraud_platform
